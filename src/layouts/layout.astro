---
import "../styles/global.css";

import SpeedInsights from "@vercel/speed-insights/astro";
import Analytics from "@vercel/analytics/astro";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title || "Kamil Zak — Software Engineer"}</title>

    <meta
      name="description"
      content="Software Engineer based in the UK, currently working at Barclays."
    />
    <meta name="keywords" content="Kamil, Zak, k9mil, Software Engineer, Software Developer" />
    <meta name="author" content="Kamil Zak" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title || "Kamil Zak — Software Engineer"} />
    <meta property="og:site_name" content="Kamil Zak" />
    <meta
      property="og:description"
      content="Software Engineer based in the UK, currently working at Barclays."
    />

    <link
      rel="preload"
      href="/fonts/OverusedGroteskRoman-VF.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="icon" href="https://emojicdn.elk.sh/🌎" />
    <SpeedInsights />
    <Analytics />
  </head>
  <body
    class="bg-[#FCFCFB] flex text-[#1b1b1b] justify-center px-6 lg:px-0 lg:pl-24 lg:justify-start"
  >
    <main
      class="flex flex-col w-full max-w-[32.5rem] lg:max-w-[42rem] items-center min-h-screen justify-center py-24 lg:py-8"
    >
      <slot />
    </main>
  </body>
</html>
